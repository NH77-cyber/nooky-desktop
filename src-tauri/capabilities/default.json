{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Nooky's windows are allowed to do. Everything that touches the OS goes through Nooky's own commands.",
  "windows": [
    "island",
    "settings"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "notification:default",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
